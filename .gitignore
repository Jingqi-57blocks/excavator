# --- Excavator runtime output ---
# Default workdir (`--workdir`, defaults to ./.excavator-work): run directories,
# prompts, checkpoints, caches and source excerpts. They contain local absolute
# paths and high-volume intermediate evidence and are never committed.
.excavator-work/
excavator-work/
.work/
**/runs/
**/cache/

# Ad-hoc report output directory.
reports/generated/*
!reports/generated/.gitkeep

# Local request files (`request.example.json` is the tracked template).
/request.json
/request.*.json
!/request.example.json

# --- CodeGraph index ---
.codegraph/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# --- Test / tooling scratch ---
coverage/
.nyc_output/
tmp/
.tmp/
*.log
!reports/**/*.log
