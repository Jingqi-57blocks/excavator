{
  "name": "excavator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A lightweight AI-first project reporting skill using optional project indexes with source-first fallback.",
  "engines": { "node": ">=22.5" },
  "bin": {
    "excavator": "./src/cli.ts",
    "excavator-html": "./packages/excavator-html/src/cli.ts"
  },
  "scripts": {
    "excavator": "node --experimental-strip-types src/cli.ts",
    "html": "node --experimental-strip-types packages/excavator-html/src/cli.ts",
    "eval": "node --experimental-strip-types eval/cli.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts packages/excavator-html/tests/*.test.ts eval/tests/*.test.ts",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts packages/excavator-html/tests/*.test.ts eval/tests/*.test.ts",
    "test:workspace": "node --experimental-strip-types tests/workspace-smoke.ts",
    "check": "node --experimental-strip-types src/cli.ts help >/dev/null && npm test"
  }
}
