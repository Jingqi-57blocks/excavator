{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excavator.57blocks.dev/schemas/v1/common.schema.json",
  "title": "Excavator v1 shared definitions",
  "$defs": {
    "schemaVersion": {
      "description": "Artifact contract version. Bumped together with the $id version segment.",
      "const": 1
    },
    "snapshotId": {
      "type": "string",
      "minLength": 1
    },
    "artifactId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "confidence": {
      "enum": ["high", "medium", "low"]
    },
    "creationMethod": {
      "description": "deterministic: produced by Core from graph, diff or structured data. agent-interpreted: drafted by the host agent from Evidence and validated by Core.",
      "enum": ["deterministic", "agent-interpreted"]
    },
    "idArray": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifactId" },
      "uniqueItems": true
    }
  }
}
