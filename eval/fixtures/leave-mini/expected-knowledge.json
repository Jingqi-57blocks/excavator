{
  "version": "expected-knowledge-v1",
  "target": "leave-mini",
  "items": [
    {
      "id": "authz-three-roles",
      "kind": "fact",
      "mustFind": true,
      "anchors": [{ "path": "src/roles.ts" }],
      "statementPatterns": ["employee.{0,40}manager|manager.{0,40}hr|员工.{0,40}经理|经理.{0,40}hr|三种?角色|三个角色|RANK|角色等级"],
      "markers": ["fact", "verified"]
    },
    {
      "id": "authz-scope-employee-self",
      "kind": "fact",
      "mustFind": true,
      "anchors": [{ "path": "src/scope.ts" }],
      "statementPatterns": ["只能看.{0,16}(自己|本人)|自己(提交)?的申请|本人提交|(equals?|等于).{0,10}(viewer|本人|自己)"]
    },
    {
      "id": "authz-scope-manager-reports",
      "kind": "fact",
      "mustFind": true,
      "anchors": [{ "path": "src/scope.ts" }],
      "statementPatterns": ["直接下属|直属下属|直接汇报|下属的申请|direct report"]
    },
    {
      "id": "authz-scope-hr-all",
      "kind": "fact",
      "mustFind": true,
      "anchors": [{ "path": "src/scope.ts" }],
      "statementPatterns": ["全部(的)?申请|所有(的)?申请|不受.{0,8}(团队|边界)|all requests"]
    },
    {
      "id": "authz-l1-guard",
      "kind": "fact",
      "mustFind": true,
      "anchors": [{ "path": "src/auth.ts" }],
      "statementPatterns": ["assertCanApproveLevel1|一级审批.{0,16}直属经理|直属经理.{0,24}(一级|才能|方可|审批)|(必须|只有|仅限?)(是)?.{0,10}直属经理"]
    },
    {
      "id": "authz-l2-guard",
      "kind": "fact",
      "mustFind": true,
      "anchors": [{ "path": "src/auth.ts" }],
      "statementPatterns": ["assertCanApproveLevel2|(二级|终审).{0,16}hr|hr.{0,24}(二级|终审)|(必须|只有|仅限?).{0,10}hr"]
    },
    {
      "id": "authz-submit-role",
      "kind": "fact",
      "mustFind": true,
      "anchors": [{ "path": "src/server.ts" }],
      "statementPatterns": ["提交|申请|submit", "员工|employee"]
    },
    {
      "id": "flow-two-level",
      "kind": "fact",
      "mustFind": true,
      "anchors": [{ "path": "src/approval.ts" }],
      "statementPatterns": ["两级|一级.*二级|经理.*HR"]
    },
    {
      "id": "flow-status-lifecycle",
      "kind": "fact",
      "mustFind": true,
      "anchors": [{ "path": "src/leave-request.ts" }],
      "statementPatterns": ["pending|待审|待批|level1Approved|一级审批|approved|审批通过|rejected|驳回|状态机|生命周期|状态流转"]
    },
    {
      "id": "flow-balance-deduct",
      "kind": "fact",
      "mustFind": true,
      "anchors": [{ "path": "src/approval.ts" }, { "path": "src/balance.ts" }],
      "statementPatterns": ["扣减|deduct", "余额|balance", "二级|终审|approved"]
    },
    {
      "id": "flow-unpaid-no-deduct",
      "kind": "fact",
      "mustFind": true,
      "anchors": [{ "path": "src/approval.ts" }],
      "statementPatterns": ["无薪|unpaid", "不扣减|不占用|跳过扣减|不.{0,6}(调用|触发|执行).{0,10}(扣减|deduct)|skip.{0,16}deduct"]
    },
    {
      "id": "flow-reject-no-deduct",
      "kind": "fact",
      "mustFind": true,
      "anchors": [{ "path": "src/approval.ts" }],
      "statementPatterns": ["驳回|reject", "不扣减|不占用|rejected"]
    },
    {
      "id": "flow-balance-insufficient",
      "kind": "fact",
      "mustFind": true,
      "anchors": [{ "path": "src/balance.ts" }],
      "statementPatterns": ["余额不足|不足|大于.{0,14}(剩余|余额)|超过.{0,14}(剩余|余额)|insufficient|exceed", "错误|抛|error|不做部分"]
    },
    {
      "id": "depth-terminal-immutable",
      "kind": "fact",
      "mustFind": true,
      "anchors": [{ "path": "src/leave-request.ts" }],
      "statementPatterns": ["终态|不可逆|不可再.{0,12}转移|不能再.{0,10}(流转|转移)|无法再.{0,10}(流转|转移)|没有.{0,14}(后继|后续|合法转移)|后继转移.{0,12}(为空|空)|terminal|no further transition"]
    },
    {
      "id": "depth-transition-whitelist",
      "kind": "fact",
      "mustFind": true,
      "anchors": [{ "path": "src/leave-request.ts" }, { "path": "src/approval.ts" }],
      "statementPatterns": ["TRANSITIONS|转移表|白名单|canTransition|状态机|state machine", "非法|不在表|不允许|拒绝|拦截|抛出?|invalid|illegal|reject"]
    },
    {
      "id": "depth-restore-uncalled",
      "kind": "fact",
      "mustFind": true,
      "anchors": [{ "path": "src/balance.ts" }],
      "statementPatterns": ["restore|归还|返还", "无.{0,20}调用|没有.{0,20}调用|未被调用|无任何调用|不存在.{0,12}调用|零命中|no caller|never called|unused|dead code"]
    },
    {
      "id": "depth-l1-status-only",
      "kind": "fact",
      "mustFind": false,
      "anchors": [{ "path": "src/approval.ts" }],
      "statementPatterns": ["一级|level.?1|直属经理", "只.{0,16}(状态|推进)|仅.{0,16}(状态|推进)|不.{0,10}(扣减|扣除|触及|涉及)|不扣"]
    },
    {
      "id": "rel-approval-flow",
      "kind": "relation",
      "mustFind": true,
      "anchors": [{ "path": "src/approval.ts" }],
      "stepPatterns": ["审批|approve"]
    },
    {
      "id": "rel-list-scope",
      "kind": "relation",
      "mustFind": false,
      "anchors": [{ "path": "src/server.ts" }, { "path": "src/scope.ts" }]
    },
    {
      "id": "unknown-carryover",
      "kind": "unknown",
      "mustFind": false,
      "anchors": [],
      "patterns": ["结转|累计|carry"]
    }
  ],
  "forbidden": [
    {
      "id": "no-notification-send",
      "patterns": [
        "发送|发出|发起|推送|下发|群发|寄送|投递|通报|sends?|sent|sending|dispatch|deliver|notif(y|ies|ied)",
        "邮件|电子邮件|email|e-?mail|短信|SMS|推送|通知|notification|message"
      ],
      "unless": [
        "不.{0,8}(发送|发出|发起|推送|下发|群发|寄送|投递|通报|发|通知)",
        "不会.{0,8}(发送|推送|通知)",
        "没有?.{0,10}(邮件|短信|推送|通知|发送|实现|提供)",
        "未.{0,8}(发送|推送|通知|实现|提供)",
        "无.{0,10}(邮件|短信|推送|通知)",
        "(刻意|故意|特意)?不(实现|提供|支持|包含|含|做)",
        "不[^。！？；\\n]{0,12}(实现|提供|支持)",
        "do(es)?\\s+not\\s+(implement|provide|support|send|email|notify|notice)",
        "not\\s+(implement|provide|support|send|sent|email|notify)",
        "no\\s+.{0,24}(notification|email|sms|push|notice|message)",
        "without\\s+.{0,20}(notification|email|message|sms)"
      ],
      "markers": ["fact", "verified"],
      "note": "leave-mini 刻意不实现任何通知能力。只有断言'发送某渠道'（发送动词 + 渠道，且无否定）的 fact 级声明才算幻觉。unless 覆盖两类诚实否定：一是'不发送/没有/未/无 通知'，二是'刻意不实现/不提供/不支持 通知'——两者都不应被判为幻觉。"
    }
  ],
  "coverage": [
    { "dimension": "authorization", "expect": ["found"] },
    { "dimension": "data-scope", "expect": ["found"] },
    { "dimension": "states-and-lifecycle", "expect": ["found"] },
    { "dimension": "calculations-and-thresholds", "expect": ["found"] }
  ]
}
